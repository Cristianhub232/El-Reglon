# Copiar a .env y cambiar los valores. .env NO se sube al repositorio.
POSTGRES_DB=elrenglon
POSTGRES_USER=elrenglon
POSTGRES_PASSWORD=cambie-esta-contrasena
POSTGRES_PUERTO=55432
APP_PUERTO=3000
BCV_HORAS=8,14,20
# Open Food Facts para identificar productos por código de barras (0 = solo caché local)
IVA_OFF=1
# Clave para cifrar los secretos de la verificación en dos pasos (obligatoria). Genérela con: openssl rand -hex 32
APP_SECRETO=
# Detrás del proxy inverso (nginx/Caddy): tomar la IP del cliente de X-Forwarded-For para los límites por IP
TRUST_PROXY=1
# Cookies de sesión solo por HTTPS (1). Póngalo en 0 solo para probar en producción sin TLS
COOKIE_SEGURA=1
# Canales de soporte que se muestran en el inicio de sesión (vacío = no se muestra)
SOPORTE_WHATSAPP=
SOPORTE_CORREO=
# Noticiero (docs/20): clave de https://worldnewsapi.com para las fuentes que no se pueden leer por RSS (TalCual). Vacía = esas fuentes quedan con error
WORLDNEWS_API_KEY=
# Minuto de cada hora en que se leen las noticias
NOTICIAS_MINUTO=5
# Perfiles de docker compose que se levantan con un simple "docker compose up -d" (producción: app,metabase)
# COMPOSE_PROFILES=app,metabase
# Metabase (opcional, perfil "metabase"; ver docs/19). Genere cada valor con: openssl rand -hex 32
METABASE_DB_PASSWORD=
METABASE_LECTURA_PASSWORD=
MB_ENCRYPTION_SECRET_KEY=
# Dirección pública de Metabase (enlaces y correos) y puerto local
METABASE_URL=https://metabase.elrenglonve.org
METABASE_PUERTO=3001
# Comparador (docs/22): 0 = no recorrer los sitemaps de las tiendas por índice en esta copia (déjelo en 1 solo en producción)
COMPARADOR_INDICE=1
# Avisos push (docs/24). Genere las claves con: npx web-push generate-vapid-keys  (la privada nunca va al repositorio)
VAPID_PUBLICO=
VAPID_PRIVADO=
VAPID_CONTACTO=mailto:soporte@elrenglonve.org
